# Copy to secrets.yaml (git-ignored) and fill in.
wifi_ssid: "your-wifi-ssid"
wifi_password: "your-wifi-password"
wifi_hotspot_password: "fallback-hotspot-password"
# 32 random bytes, base64: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
api_encryption_key: ""
# Login for the device's web page; Solar Surplus EV uses the same values (TESLA_BLE_USER / TESLA_BLE_PASSWORD in .env)
web_username: "enphase"
web_password: ""
# Car VIN. The bridge finds the car's Bluetooth address from it, so no MAC is needed.
tesla_vin: "YOUR17CHARACTERVIN"
# Second car's VIN (leave empty for one car).
tesla_vin_2: ""
